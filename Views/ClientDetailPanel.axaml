<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:HelloAvalonia.Models"
             xmlns:vm="using:HelloAvalonia.ViewModels"
             x:Class="HelloAvalonia.Views.ClientDetailPanel"
             x:DataType="vm:ClientListViewModel">
    
    <Border Background="#F8F9FA"
            BorderBrush="#DEE2E6"
            BorderThickness="1,0,0,0"
            Padding="20">
        
        <ScrollViewer>
            <StackPanel Spacing="20" IsVisible="{Binding SelectedClient, Converter={x:Static ObjectConverters.IsNotNull}}">
                
                <!-- En-tête -->
                <Border Background="#2C3E50"
                       CornerRadius="8"
                       Padding="20"
                       BoxShadow="0 2 8 1 #30000000">
                    <StackPanel Spacing="8">
                        <TextBlock Text="DÉTAILS DU CLIENT"
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Foreground="#BDC3C7"
                                  LetterSpacing="1"/>
                        <TextBlock Text="{Binding SelectedClient.Nom}"
                                  FontSize="24"
                                  FontWeight="Bold"
                                  Foreground="White"/>
                    </StackPanel>
                </Border>
                
                <!-- Informations principales -->
                <Border Background="White"
                       CornerRadius="8"
                       Padding="20"
                       BoxShadow="0 2 8 1 #20000000">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Informations"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="#2C3E50"/>
                        
                        <Separator Background="#DEE2E6" Height="1"/>
                        
                        <!-- ID et Email en horizontal -->
                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
                            <!-- ID -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="ID Client"
                                          FontSize="12"
                                          Foreground="#7F8C8D"
                                          FontWeight="Medium"/>
                                <Border Background="#E8F5E9"
                                       CornerRadius="6"
                                       Padding="12,8">
                                    <TextBlock Text="{Binding SelectedClient.Id, StringFormat='#{0}'}"
                                              FontSize="16"
                                              FontWeight="Bold"
                                              Foreground="#27AE60"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- Espacement -->
                            <Rectangle Grid.Column="1" Width="15"/>
                            
                            <!-- Email -->
                            <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Spacing="4">
                                <TextBlock Text="Email"
                                          FontSize="12"
                                          Foreground="#7F8C8D"
                                          FontWeight="Medium"/>
                                <Border Background="#E3F2FD"
                                       CornerRadius="6"
                                       Padding="12,8">
                                    <TextBlock Text="{Binding SelectedClient.Email}"
                                              FontSize="14"
                                              Foreground="#2980B9"
                                              TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Adresses -->
                <Border Background="White"
                       CornerRadius="8"
                       Padding="20"
                       BoxShadow="0 2 8 1 #20000000">
                    <StackPanel Spacing="15">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                      Text="Adresses"
                                      FontSize="16"
                                      FontWeight="SemiBold"
                                      Foreground="#2C3E50"/>
                            <Border Grid.Column="1"
                                   Background="#3498DB"
                                   CornerRadius="12"
                                   Padding="10,4"
                                   MinWidth="35"
                                   HorizontalAlignment="Center">
                                <TextBlock Text="{Binding SelectedClient.Adresses.Count}"
                                          FontSize="14"
                                          FontWeight="Bold"
                                          Foreground="White"
                                          HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        
                        <Separator Background="#DEE2E6" Height="1"/>
                        
                        <!-- Liste des adresses en badges -->
                        <ItemsControl ItemsSource="{Binding SelectedClient.Adresses}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:Adresse">
                                    <Border Background="#F39C12"
                                           CornerRadius="8"
                                           Padding="15,10"
                                           Margin="0,0,10,10"
                                           BoxShadow="0 2 6 0 #30000000">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding Rue}"
                                                      FontSize="14"
                                                      FontWeight="SemiBold"
                                                      Foreground="White"
                                                      TextWrapping="Wrap"/>
                                            <TextBlock FontSize="13"
                                                      Foreground="#FFFFFF"
                                                      Opacity="0.9">
                                                <Run Text="{Binding CodePostal}"/>
                                                <Run Text="{Binding Ville}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Type}"
                                                      FontSize="12"
                                                      Foreground="#FFFFFF"
                                                      Opacity="0.85"
                                                      FontStyle="Italic"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
        
    </Border>
    
</UserControl>
